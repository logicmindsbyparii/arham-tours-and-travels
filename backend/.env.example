# ---------------------------------------------------------------------------
# Arham Tours & Travels API. Copy to .env and fill in real values.
# Never commit the real .env file.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=5000

# Local:  mongodb://127.0.0.1:27017/arham_tours
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/arham_tours?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/arham_tours

# Two different long random strings (at least 32 characters each). Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars
CSRF_SECRET=replace-with-a-different-long-random-secret-32-chars

# How long an admin session lasts, in hours.
SESSION_TTL_HOURS=8

# Comma-separated list of browser origins allowed to call the API with cookies.
FRONTEND_ORIGIN=http://localhost:5173

# Session cookie. In production serve the API over HTTPS and keep COOKIE_SECURE=true.
# Use COOKIE_SAMESITE=none only when the website and the API are on different
# sites (different registrable domains); it requires COOKIE_SECURE=true.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
# Optional, e.g. .example.com to share the cookie with an API subdomain.
COOKIE_DOMAIN=

# Set to 1 (or the number of proxies) behind a reverse proxy / load balancer,
# so rate limiting sees the real client IP.
TRUST_PROXY=0

# Uploaded images are stored on disk in this folder and served at /uploads.
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=5

# First admin account, read only by `npm run seed:admin`.
# Remove these values from the server environment after seeding.
SEED_ADMIN_NAME=Site Administrator
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
